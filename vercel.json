{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    { "source": "/py/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/py/(.*).wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
